    "Great focus! Relax for %@." : {
      "comment" : "Notification when a focus session ends and the break starts automatically. %@ = duration like '5 minutes'.",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harika odaklandın! Şimdi %@ dinlen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "专注得真棒！休息 %@ 吧。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "專注得真棒！休息 %@ 吧。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",

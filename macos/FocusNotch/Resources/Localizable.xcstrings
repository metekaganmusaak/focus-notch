    "Great focus! Start your break whenever you're ready." : {
      "comment" : "Notification when a focus session ends and the break waits for the user.",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harika odaklandın! Hazır olduğunda molanı başlat."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "专注得真棒！准备好后随时开始休息吧。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "專注得真棒！準備好後隨時開始休息吧。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बढ़िया फ़ोकस! जब तैयार हों, तब अपना ब्रेक शुरू करें।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Gran concentración! Empieza tu descanso cuando quieras."
          }

    "Changes apply to the next phase if a timer is already running." : {
      "comment" : "Settings footer about duration changes.",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamanlayıcı zaten çalışıyorsa değişiklikler bir sonraki aşamadan itibaren geçerli olur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果计时器正在运行，更改将从下一阶段开始生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若計時器正在執行，變更將從下一個階段開始生效。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगर टाइमर पहले से चल रहा है, तो बदलाव अगले चरण से लागू होंगे।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si ya hay un temporizador en marcha, los cambios se aplicarán a partir de la siguiente fase."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si un minuteur est déjà en cours, les modifications s’appliqueront à partir de la phase suivante."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا كان المؤقت قيد التشغيل، فستُطبَّق التغييرات على المرحلة التالية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "টাইমার আগে থেকেই চালু থাকলে পরিবর্তনগুলো পরের পর্ব থেকে কার্যকর হবে।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se um timer já estiver em andamento, as alterações valem a partir da próxima fase."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если таймер уже запущен, изменения вступят в силу со следующей фазы."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اگر ٹائمر پہلے سے چل رہا ہو تو تبدیلیاں اگلے مرحلے سے لاگو ہوں گی۔"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika timer sedang berjalan, perubahan berlaku mulai fase berikutnya."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läuft bereits ein Timer, gelten Änderungen ab der nächsten Phase."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイマーの実行中に変更した場合は、次のフェーズから適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "타이머가 이미 실행 중이면 변경 사항은 다음 단계부터 적용됩니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu bộ hẹn giờ đang chạy, các thay đổi sẽ được áp dụng từ giai đoạn tiếp theo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se un timer è già in corso, le modifiche verranno applicate dalla fase successiva."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اگر زمان‌سنج در حال اجرا باشد، تغییرات از مرحلهٔ بعد اعمال می‌شوند."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli minutnik już działa, zmiany obowiązują od następnej fazy."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо таймер уже запущено, зміни застосуються з наступної фази."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากตัวจับเวลากำลังทำงานอยู่ การเปลี่ยนแปลงจะมีผลในช่วงถัดไป"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als er al een timer loopt, gelden wijzigingen vanaf de volgende fase."
          }
        }
      }
    },

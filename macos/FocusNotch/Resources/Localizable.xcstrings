    "Add your own pet: drop an animated GIF here or click +." : {
      "comment" : "Hint under the pet grid in settings.",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kendi evcil hayvanını ekle: buraya hareketli bir GIF bırak ya da + simgesine tıkla."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加你自己的宠物：将动态 GIF 拖到此处，或点按“+”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加入你自己的寵物：將動態 GIF 拖移到這裡，或按一下「+」。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपना पालतू जोड़ें: यहाँ कोई ऐनिमेटेड GIF ड्रॉप करें या + पर क्लिक करें।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade tu propia mascota: suelta aquí un GIF animado o haz clic en +."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute ton propre animal : dépose un GIF animé ici ou clique sur +."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضِف حيوانك الأليف الخاص: اسحب صورة GIF متحركة وأفلِتها هنا أو انقر على +."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নিজের পোষা প্রাণী যোগ করুন: এখানে একটি অ্যানিমেটেড GIF ছেড়ে দিন অথবা + চিহ্নে ক্লিক করুন।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione seu próprio bichinho: solte um GIF animado aqui ou clique em +."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавь своего питомца: перетащи сюда анимированный GIF или нажми +."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپنا پالتو جانور شامل کریں: یہاں کوئی متحرک GIF چھوڑیں یا + پر کلک کریں۔"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan peliharaanmu sendiri: seret GIF animasi ke sini atau klik +."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge dein eigenes Haustier hinzu: Zieh ein animiertes GIF hierher oder klicke auf +."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分だけのペットを追加：アニメーションGIFをここにドロップするか、「+」をクリックしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나만의 펫 추가: 움직이는 GIF를 여기에 끌어다 놓거나 + 버튼을 클릭하세요."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm thú cưng của riêng bạn: kéo ảnh GIF động vào đây hoặc bấm +."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi il tuo animaletto: trascina qui una GIF animata o fai clic su +."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حیوان خانگی خودتان را اضافه کنید: یک GIF متحرک را اینجا رها کنید یا روی + کلیک کنید."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj własnego zwierzaka: upuść tutaj animowany GIF lub kliknij +."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додай свого улюбленця: перетягни сюди анімований GIF або натисни +."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่มสัตว์เลี้ยงของคุณเอง: ลาก GIF แบบเคลื่อนไหวมาวางที่นี่ หรือคลิก +"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg je eigen huisdier toe: sleep hier een geanimeerde GIF naartoe of klik op +."
          }
        }
      }
    },

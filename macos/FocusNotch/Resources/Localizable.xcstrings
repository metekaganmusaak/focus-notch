    "Pick a topic in the notch before you start, and your focus time is counted under it." : {
      "comment" : "Settings footer. 'the notch' is the MacBook notch area where the timer lives; use the usual local term (many languages keep 'notch').",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başlamadan önce çentikten bir konu seç; odak süren o konuya sayılır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开始前在刘海中选择一个主题，专注时长就会计入该主题。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開始前在瀏海中選擇一個主題，專注時間就會計入該主題。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शुरू करने से पहले नॉच में एक विषय चुनें, और आपका फ़ोकस समय उसी में गिना जाएगा।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un tema en el notch antes de empezar y tu tiempo de concentración se contará en él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisis un sujet dans l’encoche avant de commencer : ton temps de concentration y sera comptabilisé."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر موضوعًا في النتوء قبل أن تبدأ، وسيُحتسب وقت تركيزك ضمنه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শুরু করার আগে নচে একটি বিষয় বেছে নিন, তাহলে আপনার ফোকাসের সময় সেই বিষয়ের অধীনে গণনা হবে।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha um tópico no notch antes de começar e seu tempo de foco será contado nele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбери тему в вырезе перед стартом, и время фокуса будет засчитано в неё."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شروع کرنے سے پہلے نوچ میں ایک موضوع منتخب کریں، اور آپ کا فوکس کا وقت اسی کے تحت شمار ہوگا۔"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih topik di notch sebelum mulai, dan waktu fokusmu akan dihitung untuk topik itu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle vor dem Start in der Notch ein Thema, dann wird deine Fokuszeit dafür gezählt."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開始前にノッチでトピックを選ぶと、集中時間がそのトピックに記録されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",

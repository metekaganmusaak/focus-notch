          "stringUnit" : {
            "state" : "translated",
            "value" : "Belle concentration ! Détends-toi pendant %@."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تركيز رائع! استرخِ لمدة %@."

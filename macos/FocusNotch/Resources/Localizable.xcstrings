    "Your friend works alongside you during focus sessions and naps during breaks." : {
      "comment" : "Settings footer describing the pet.",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostun, odak oturumlarında seninle birlikte çalışır, molalarda ise kestirir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "专注时，你的伙伴会陪你一起努力；休息时，它会小睡一会儿。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "專注時，你的夥伴會陪你一起努力；休息時，牠會小睡片刻。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका साथी फ़ोकस सेशन के दौरान आपके साथ काम करता है और ब्रेक में झपकी लेता है।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu compañero trabaja contigo durante las sesiones de concentración y se echa la siesta en los descansos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton compagnon travaille à tes côtés pendant les sessions de concentration et fait la sieste pendant les pauses."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعمل رفيقك إلى جانبك خلال جلسات التركيز ويأخذ قيلولة خلال الاستراحات."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ফোকাস সেশনের সময় আপনার সঙ্গী আপনার পাশে বসে কাজ করে, আর বিরতিতে একটু ঘুমিয়ে নেয়।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu amigo trabalha ao seu lado durante as sessões de foco e tira uma soneca nas pausas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твой питомец работает вместе с тобой во время сессий фокуса и дремлет в перерывах."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کا ساتھی فوکس سیشنز کے دوران آپ کے ساتھ کام کرتا ہے اور وقفوں میں جھپکی لیتا ہے۔"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temanmu ikut bekerja bersamamu selama sesi fokus dan tidur sebentar saat istirahat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Fokusfreund arbeitet in Fokus-Sessions mit dir und macht in den Pausen ein Nickerchen."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォーカスフレンドは、集中セッション中はあなたと一緒にがんばり、休憩中はお昼寝します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "집중 세션 동안에는 친구가 곁에서 함께 일하고, 휴식 시간에는 낮잠을 자요."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn đồng hành sẽ làm việc cùng bạn trong các phiên tập trung và chợp mắt trong giờ nghỉ."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo amico lavora con te durante le sessioni di focus e fa un pisolino durante le pause."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "همراهتان در جلسه‌های تمرکز کنار شما کار می‌کند و در استراحت‌ها چرت می‌زند."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój zwierzak pracuje razem z tobą podczas sesji skupienia i drzemie w przerwach."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твій улюбленець працює разом із тобою під час сесій фокусу й дрімає на перервах."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพื่อนของคุณจะตั้งใจทำงานไปพร้อมกับคุณระหว่างรอบโฟกัส และงีบหลับระหว่างพัก"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je maatje werkt met je mee tijdens focussessies en doet een dutje in de pauzes."
          }
        }
      }
    },

        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belle concentration ! Commence ta pause quand tu veux."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تركيز رائع! ابدأ استراحتك متى كنت جاهزًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "দারুণ ফোকাস! প্রস্তুত হলেই বিরতি শুরু করুন।"

{
  "name": "focus-notch",
  "productName": "Focus Notch",
  "version": "1.2.0",
  "description": "A Pomodoro timer with cute pets that lives in a virtual notch at the top of your screen.",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "sync": "node scripts/sync-assets.mjs",
    "start": "npm run sync && electron .",
    "snapshot": "npm run sync && electron . --snapshot",
    "dist": "npm run sync && electron-builder --win nsis --x64 --arm64"
  },
  "build": {
    "appId": "com.focusnotch.app",
    "productName": "Focus Notch",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.png",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Focus Notch"
    }
  },
  "devDependencies": {
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3"
  }
}
